# Deployment-owned settings for `pawzochat server run`.
# Do not put the administrator password or provider API keys in this file.
PAWZOCHAT_DATA_DIR=/var/lib/pawzochat
PAWZOCHAT_BIND=127.0.0.1
PAWZOCHAT_PORT=62000
PAWZOCHAT_PUBLIC_URL=https://chat.example.com
PAWZOCHAT_PROXY_HOPS=1

# This affects only the PawzoChat process, not the host operating system.
TZ=Asia/Shanghai
